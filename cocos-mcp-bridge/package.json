{
  "name": "cocos-mcp-bridge",
  "title": "i18n:cocos-mcp-bridge.title",
  "package_version": 2,
  "version": "0.5.0",
  "description": "Sovereign embedded MCP server for Cocos Creator with scene/script execution, project resources, prompts, file/scene tools, and built-in AI image generation. Single endpoint, no upstream phone-home.",
  "author": "AI Game Studio",
  "license": "MIT",
  "main": "browser.js",
  "bin": {
    "cocos-mcp-bridge": "bin/cocos-mcp-bridge.js"
  },
  "mcpName": "io.github.ai-game-studio/cocos-mcp-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-game-studio/cocos-mcp-bridge.git"
  },
  "homepage": "https://github.com/ai-game-studio/cocos-mcp-bridge#readme",
  "bugs": {
    "url": "https://github.com/ai-game-studio/cocos-mcp-bridge/issues"
  },
  "keywords": [
    "mcp",
    "cocos",
    "cocos-creator",
    "cocos-mcp-bridge",
    "ai-game-studio",
    "model-context-protocol",
    "ai",
    "image-generation"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "docs/",
    "lib/",
    "i18n/",
    "panel/",
    "browser.js",
    "scene.js",
    "server.json",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check browser.js && node --check scene.js && node --check panel/index.js && node --check panel/shared.js && node --check panel/tool-description-i18n.js && node --check panel/tool-exposure.js && node --check panel/settings.js && node --check bin/cocos-mcp-bridge.js && node --check i18n/en.js && node --check i18n/zh.js && node --check lib/assets.js && node --check lib/client-config.js && node --check lib/config.js && node --check lib/diagnostics.js && node --check lib/electron-tools.js && node --check lib/i18n.js && node --check lib/input.js && node --check lib/interaction-log.js && node --check lib/javascript-safety.js && node --check lib/logs.js && node --check lib/path-safety.js && node --check lib/prefabs.js && node --check lib/project-instructions.js && node --check lib/prompts.js && node --check lib/resources.js && node --check lib/runtime-log.js && node --check lib/scenes.js && node --check lib/screenshots.js && node --check lib/server.js && node --check lib/tool-profiles.js && node --check lib/tool-registry.js && node --check lib/tools/assets-advanced.js && node --check lib/tools/cocos-project.js && node --check lib/tools/files.js && node --check lib/tools/scene-events.js && node --check lib/tools/image-gen.js && node --check lib/update-checker.js && node --check lib/updater.js && node --check lib/utils.js && node --check scripts/generate-tool-docs.js",
    "test": "node --test",
    "docs:generate": "node scripts/generate-tool-docs.js",
    "docs:check": "node scripts/generate-tool-docs.js --check",
    "pack:dry-run": "npm pack --dry-run",
    "registry:validate": "mcp-publisher validate server.json"
  },
  "panels": {
    "default": {
      "title": "i18n:cocos-mcp-bridge.panel_server",
      "type": "dockable",
      "main": "panel/index.js",
      "size": {
        "min-width": 420,
        "min-height": 360,
        "width": 560,
        "height": 620
      }
    },
    "tool-exposure": {
      "title": "i18n:cocos-mcp-bridge.panel_tool_exposure",
      "type": "dockable",
      "main": "panel/tool-exposure.js",
      "size": {
        "min-width": 560,
        "min-height": 460,
        "width": 760,
        "height": 760
      }
    },
    "settings": {
      "title": "i18n:cocos-mcp-bridge.panel_settings",
      "type": "dockable",
      "main": "panel/settings.js",
      "size": {
        "min-width": 460,
        "min-height": 360,
        "width": 620,
        "height": 620
      }
    },
    "codely": {
      "title": "i18n:cocos-mcp-bridge.panel_codely",
      "type": "dockable",
      "main": "panel/codely.js",
      "size": {
        "width": 420,
        "height": 720
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "Cocos AI",
        "label": "i18n:cocos-mcp-bridge.menu_server",
        "message": "open-panel"
      },
      {
